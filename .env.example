# ==============================================================================
# HelpDesk Mini - Unified Environment Configuration
# ==============================================================================

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=mini_helpdesk
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5432/mini_helpdesk

# Backend Service
SECRET_KEY=change-me-super-secret-jwt-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000
BACKEND_PORT=8000

# Frontend Service
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ==============================================================================
# HelpDesk Mini - Unified Environment Configuration
# ==============================================================================

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=mini_helpdesk
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5432/mini_helpdesk

# Backend Service
SECRET_KEY=change-me-super-secret-jwt-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000
BACKEND_PORT=8000

# Cloudflare R2 Storage (Optional: if empty/unset, defaults to local ./uploads)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
R2_PUBLIC_URL=https://pub-your-bucket.r2.dev
R2_ENDPOINT_URL=


# Frontend Service
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
